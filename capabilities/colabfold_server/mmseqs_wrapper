#!/bin/bash
# mmseqs GPU 租约包装器。
#
# 对目标库带 .is_gpu_db 标记的 search,先从共享 GPU 池租卡(redis,与 gpu_manager.py
# 同协议:BLPOP available → HSET in_use → 心跳 task_heartbeat:<owner> → 条件释放),
# 再以 CUDA_VISIBLE_DEVICES + --gpu 1 --prefilter-mode 1 执行。
#
# 失败策略:绝不做 CPU 降级。redis 故障、等待超时、NVML 坏死一律 exit 75,让
# ticket 显式置 ERROR——CPU 路径的等价计算慢三个数量级,降级即故障转移。
#
# 等待登记(软保留协议的 MSA 侧):等卡期间向 boltz_gpu_pool:msa_waiting (ZSET)
# 持续刷新 owner 的 score;gpu_manager.msa_reservation_blocks 据此让长任务为 MSA
# 让出空卡。条目停止刷新即视为死亡,由 python 侧按 GPU_MSA_WAITER_STALE_SECONDS 清理。
#
# 纯 bash + /dev/tcp,零运行时依赖。以 bind-mount 安装为容器内
# /app/mmseqs/bin/mmseqs,由 Go 服务经 config.json paths.mmseqs 调用。

mode="${MMSEQS_LOAD_MODE:-}"
if [[ -n "$mode" && ! "$mode" =~ ^[0-9]+$ ]]; then
  mode=""
fi

real_bin="${MMSEQS_REAL_BIN:-/app/mmseqs/bin/mmseqs.real}"
if [[ ! -x "$real_bin" ]]; then
  echo "No usable MMseqs binary found at: ${real_bin}" >&2
  exit 1
fi

cmd="$1"
if [[ -z "$cmd" || "$cmd" == "version" || "$cmd" == "help" || "$cmd" == "list" ]]; then
  exec "$real_bin" "$@"
fi

shift
# 剥离 msa.sh 自带的 --db-load-mode,统一改用 MMSEQS_LOAD_MODE。
sanitized_args=()
skip_next=0
for arg in "$@"; do
  if [[ "$skip_next" = 1 ]]; then
    skip_next=0
    continue
  fi
  if [[ "$arg" == "--db-load-mode" ]]; then
    skip_next=1
    continue
  fi
  sanitized_args+=("$arg")
done

# GPU 兼容库(<X>_gpu)的 .idx 只含 padded 索引,不含序列数据;下游 CPU 模块须按
# 官方 GPU 协议改用 <X>_seq / <X>_aln。search 不改写(直接扫 padded 库本体)。
rewrite_gpu_target_args() {
  local -n dst=$1; local cmdname=$2; shift 2
  dst=("$@")
  local marker=""
  local a base
  for a in "$@"; do
    base="$a"; [[ "$a" == *.idx ]] && base="${a%.idx}"
    if [[ -e "${base}.is_gpu_db" ]]; then marker="$base"; break; fi
  done
  [[ -z "$marker" ]] && return 0
  local i=0
  local t1=1 t2=3
  case "$cmdname" in
    expandaln) ;;
    align|convertalis|filterresult|result2msa|result2profile) t2=-1 ;;
    *) return 0 ;;
  esac
  for a in "$@"; do
    if [[ $i -eq $t1 && "$a" == *.idx ]]; then
      dst[$i]="${a%.idx}_seq"
    elif [[ $i -eq $t2 && "$a" == *.idx ]]; then
      dst[$i]="${a%.idx}_aln"
    fi
    i=$((i+1))
  done
}

rewrite_gpu_target_args rewritten_args "$cmd" "${sanitized_args[@]}"

# 限制每个重子命令的线程数:mmseqs.real 会自动占满全部核心,8 个并发 worker
# 会叠加成百线程超订,线程上限 = MMSEQS_NUM_THREADS(默认 16)。
if [[ "$cmd" =~ ^(search|expandaln|filterresult|result2msa|result2profile|align|convertalis|prefilter)$ ]]; then
  has_threads=0
  for a in "${rewritten_args[@]}"; do [[ "$a" == "--threads" ]] && has_threads=1; done
  if [[ $has_threads -eq 0 ]]; then
    rewritten_args+=("--threads" "${MMSEQS_NUM_THREADS:-16}")
  fi
fi

case "$cmd" in
  search|expandaln|filterresult|result2msa|result2profile|align|convertalis|prefilter)
    if [[ -n "$mode" ]]; then
      set -- "$cmd" --db-load-mode "$mode" "${rewritten_args[@]}"
    else
      set -- "$cmd" "${rewritten_args[@]}"
    fi
    ;;
  *)
    set -- "$cmd" "${rewritten_args[@]}"
    ;;
esac

# 模板搜索跳过(MSA_SKIP_TEMPLATES=1):pdb100 是 CPU 高敏感度路径且消费方不读
# 模板;跳过 search,由下方 convertalis 分支落空 pdb70.m8。
if [[ "${MSA_SKIP_TEMPLATES:-0}" == "1" && "$cmd" == "search" ]]; then
  for a in "${rewritten_args[@]}"; do
    if [[ "$a" == *pdb100* ]]; then
      echo "[msa-gpu] template search skipped (MSA_SKIP_TEMPLATES=1): $a" >&2
      exit 0
    fi
  done
fi

if [[ "${MSA_SKIP_TEMPLATES:-0}" == "1" && "$cmd" == "convertalis" ]]; then
  _has_pdb=0
  for a in "${rewritten_args[@]}"; do
    [[ "$a" == *pdb100* ]] && _has_pdb=1 && break
  done
  if [[ $_has_pdb -eq 1 ]]; then
    _in_res="${rewritten_args[2]}"
    if [[ ! -f "${_in_res}.index" && ! -f "${_in_res}" ]]; then
      _out_m8="${rewritten_args[3]}"
      : > "$_out_m8"
      echo "[msa-gpu] convertalis on skipped templates -> empty $_out_m8" >&2
      exit 0
    fi
  fi
fi

# GPU 租约仅适用于 search + 带 .is_gpu_db 标记的填充库;其余命令直接透传
# (独立 prefilter 不支持 --gpu,非填充库传 --gpu 会报 invalid GPU database)。
want_gpu=0
if [[ "${COLABFOLD_ENABLE_GPU:-0}" == "1" && "$cmd" == "search" ]]; then
  for arg in "${sanitized_args[@]}"; do
    if [[ -e "${arg}.is_gpu_db" ]]; then
      want_gpu=1
      break
    fi
  done
fi
if [[ "$want_gpu" != "1" ]]; then
  exec "$real_bin" "$@"
fi

MSA_GPU_REDIS_HOST="${MSA_GPU_REDIS_HOST:-172.17.3.200}"
MSA_GPU_REDIS_PORT="${MSA_GPU_REDIS_PORT:-6379}"
MSA_GPU_WAIT_SECONDS="${MSA_GPU_WAIT_SECONDS:-600}"
POOL_KEY="${MSA_GPU_POOL_KEY:-boltz_gpu_pool:available}"
IN_USE_KEY="${MSA_GPU_IN_USE_KEY:-boltz_gpu_pool:in_use}"
# 须与 gpu_manager 侧 GPU_MSA_WAITING_ZSET_KEY 一致(部署未启用池命名空间,裸键)。
WAITING_KEY="${MSA_GPU_WAITING_ZSET_KEY:-boltz_gpu_pool:msa_waiting}"
HEARTBEAT_INTERVAL=20
HEARTBEAT_TTL=60
# 单条 search 的硬超时:卡死的 search 被击杀后经 trap 归还租约,否则一张卡永久泄漏。
MMSEQS_GPU_SEARCH_TIMEOUT="${MMSEQS_GPU_SEARCH_TIMEOUT:-1800}"
# 租约年龄下限:持有者发出首次心跳前,回收逻辑必须跳过。
LEASE_MIN_AGE_SECONDS=120

# 发送一条 RESP 命令,解析单条回复到 REPLY(+status / :int / bulk / array-of-bulk)。
redis_cmd() {
  local req="*$#\r\n" arg
  for arg in "$@"; do
    req+="$"${#arg}"\r\n$arg\r\n"
  done
  exec 3<>"/dev/tcp/$MSA_GPU_REDIS_HOST/$MSA_GPU_REDIS_PORT" || return 1
  printf '%b' "$req" >&3
  REPLY=$(_redis_read_reply)
  local rc=$?
  exec 3>&- 3<&-
  return $rc
}

_redis_read_reply() {
  local line kind len i n out
  IFS= read -r line <&3 || return 1
  line=${line%$'\r'}
  kind=${line:0:1}
  case "$kind" in
    '+'|':') printf '%s' "${line:1}"; return 0 ;;
    '-') return 1 ;;
    '$')
      len=${line:1}
      [[ "$len" == "-1" ]] && return 0
      IFS= read -r -N $((len + 2)) line <&3 || return 1
      printf '%s' "${line:0:len}"
      return 0 ;;
    '*')
      n=${line:1}
      [[ "$n" == "-1" ]] && return 0
      out=()
      for ((i = 0; i < n; i++)); do
        out+=("$(_redis_read_reply)")
      done
      printf '%s\n' "${out[@]}"
      return 0 ;;
    *) return 1 ;;
  esac
}

# 等待登记:ZSET member=owner, score=刷新 epoch。等卡期间每轮刷新;
# 死亡条目由 python 侧按 GPU_MSA_WAITER_STALE_SECONDS 自愈清理。
register_wait() {
  redis_cmd ZADD "$WAITING_KEY" "$(date +%s)" "$1" >/dev/null 2>&1 || true
}
unregister_wait() {
  redis_cmd ZREM "$WAITING_KEY" "$1" >/dev/null 2>&1 || true
}

# 输出 "<gpu> <owner>";rc=1 redis 故障,rc=2 等待超时,rc=3 NVML 坏死。
# MSA_GPU_WAIT_SECONDS=0 表示无限 FIFO 等待(缺省 600s):BLPOP 即公平队列。
lease_gpu() {
  local owner="colabfold_msa:$$:$(date +%s)"
  local deadline=$(( $(date +%s) + MSA_GPU_WAIT_SECONDS )) slice result value
  # 连续非数字的 nvidia-smi 输出说明 NVML 本身坏死(忙卡只是数字小,可以等);
  # 给瞬时抖动留 MSA_GPU_NVML_MAX_FAILURES 次重试,超限快速失败避免无限 requeue。
  local nvml_fail_count=0
  local nvml_max=${MSA_GPU_NVML_MAX_FAILURES:-6}
  local waited=0
  while :; do
    if (( MSA_GPU_WAIT_SECONDS > 0 )) && (( $(date +%s) >= deadline )); then
      unregister_wait "$owner"
      return 2
    fi
    register_wait "$owner"
    reclaim_stale_leases
    slice=$(( deadline - $(date +%s) ))
    (( slice > 30 )) && slice=30
    (( slice < 1 )) && slice=1
    if ! redis_cmd BLPOP "$POOL_KEY" "$slice"; then
      unregister_wait "$owner"
      return 1
    fi
    value=$(printf '%s\n' "$REPLY" | tail -1)
    if [[ -z "$value" ]]; then
      waited=$((waited + slice))
      echo "[msa-gpu] GPU pool empty; job queued waiting for a lease (${waited}s)" >&2
      continue
    fi
    # 原子认领:弹卡与登记之间该卡对池和 in_use 均不可见,并发的池重建会把它
    # 重新派发,HSETNX 失败即说明已被其他消费者认领,本卡放弃继续等下一张。
    if ! redis_cmd HSETNX "$IN_USE_KEY" "$value" "$owner"; then
      unregister_wait "$owner"
      return 1
    fi
    if [[ "$REPLY" != "1" ]]; then
      echo "[msa-gpu] GPU $value claimed elsewhere; picking next" >&2
      continue
    fi
    # 池记账与显存现实可能漂移;空余显存不足以承载 CUDA 上下文的卡退租回插队尾,
    # 等其持有者退出后自然过检。
    free_mib=$(nvidia-smi --id="$value" --query-gpu=memory.free                  --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
    if [[ ! "$free_mib" =~ ^[0-9]+$ ]]; then
      nvml_fail_count=$((nvml_fail_count + 1))
      redis_cmd HDEL "$IN_USE_KEY" "$value" >/dev/null || true
      redis_cmd RPUSH "$POOL_KEY" "$value" >/dev/null || true
      if (( nvml_fail_count >= nvml_max )); then
        echo "[msa-gpu] nvidia-smi unusable in this container (${free_mib:-empty output}); NVML broken (driver/library mismatch?) - failing job so the ticket errors out visibly instead of requeue-looping" >&2
        unregister_wait "$owner"
        return 3
      fi
      echo "[msa-gpu] GPU $value nvidia-smi failed (${free_mib:-empty output}); try $nvml_fail_count/$nvml_max" >&2
      sleep 5
      continue
    fi
    nvml_fail_count=0
    if (( free_mib < ${MSA_GPU_MIN_FREE_MIB:-8000} )); then
      redis_cmd HDEL "$IN_USE_KEY" "$value" >/dev/null || true
      redis_cmd RPUSH "$POOL_KEY" "$value" >/dev/null || true
      echo "[msa-gpu] GPU $value physically busy (${free_mib}MiB free); requeued" >&2
      sleep 5
      continue
    fi
    unregister_wait "$owner"
    # TOCTOU 复查:租下后静置数秒再确认显存空闲,防止与池外容器的显存分配竞态;
    # 复查不过则还卡回队尾继续等待。
    sleep 8
    free2=$(nvidia-smi --id="$value" --query-gpu=memory.free \
              --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
    if [[ ! "$free2" =~ ^[0-9]+$ ]]; then
      nvml_fail_count=$((nvml_fail_count + 1))
      redis_cmd HDEL "$IN_USE_KEY" "$value" >/dev/null || true
      redis_cmd RPUSH "$POOL_KEY" "$value" >/dev/null || true
      if (( nvml_fail_count >= nvml_max )); then
        echo "[msa-gpu] nvidia-smi unusable after lease (${free2:-empty output}); NVML broken - failing job instead of requeue-looping" >&2
        return 3
      fi
      echo "[msa-gpu] GPU $value nvidia-smi failed after lease (${free2:-empty output}); try $nvml_fail_count/$nvml_max" >&2
      sleep 5
      continue
    fi
    if (( free2 < ${MSA_GPU_MIN_FREE_MIB:-8000} )); then
      redis_cmd HDEL "$IN_USE_KEY" "$value" >/dev/null || true
      redis_cmd RPUSH "$POOL_KEY" "$value" >/dev/null || true
      echo "[msa-gpu] GPU $value flaked after lease (${free2}MiB); requeued" >&2
      sleep 5
      continue
    fi
    printf '%s %s' "$value" "$owner"
    return 0
  done
  return 2
}

# 回收陈旧租约:owner 租龄超过 LEASE_MIN_AGE_SECONDS 且心跳已过期。
# wrapper 侧唯一的清扫路径(SIGKILL 绕过 trap),与 gpu_manager reconcile 的
# 显存门控回收互补;HDEL 原子性保证并发回收只入队一次。
reclaim_stale_leases() {
  local now gpu owner ts
  if ! redis_cmd HGETALL "$IN_USE_KEY"; then
    return 0
  fi
  local -a entries
  mapfile -t entries <<< "$REPLY"
  (( ${#entries[@]} >= 2 )) || return 0
  now=$(date +%s)
  local i
  for (( i = 0; i + 1 < ${#entries[@]}; i += 2 )); do
    gpu="${entries[i]}"
    owner="${entries[i + 1]}"
    ts="${owner##*:}"
    [[ "$ts" =~ ^[0-9]+$ ]] || continue
    (( now - ts <= LEASE_MIN_AGE_SECONDS )) && continue
    if ! redis_cmd EXISTS "task_heartbeat:$owner"; then
      continue
    fi
    [[ "$REPLY" == "1" ]] && continue
    if ! redis_cmd HDEL "$IN_USE_KEY" "$gpu"; then
      continue
    fi
    [[ "$REPLY" == "1" ]] || continue
    redis_cmd RPUSH "$POOL_KEY" "$gpu" >/dev/null || true
    echo "[msa-gpu] reclaimed stale lease GPU $gpu (owner $owner)" >&2
  done
}

release_gpu() {  # $1=gpu $2=owner;仅当 lease 仍归本 owner 时释放
  local gpu="$1" owner="$2" current
  if redis_cmd HGET "$IN_USE_KEY" "$gpu"; then
    current="$REPLY"
    if [[ "$current" == "$owner" ]]; then
      redis_cmd HDEL "$IN_USE_KEY" "$gpu" >/dev/null
      redis_cmd RPUSH "$POOL_KEY" "$gpu" >/dev/null
    fi
  fi
}

GPU_ID=""
OWNER=""
HB_PID=""

# 心跳必须跟随每一次成功租约:换卡重租会更换 owner,旧心跳已随
# cleanup_lease_force 终止,漏启新心跳会让活租约被兄弟 wrapper 依"心跳过期"
# 规则回收,造成双租约。
start_heartbeat() {
  (
    while :; do
      redis_cmd SETEX "task_heartbeat:$OWNER" "$HEARTBEAT_TTL" 1 >/dev/null 2>&1
      sleep "$HEARTBEAT_INTERVAL"
    done
  ) &
  HB_PID=$!
}

# SIGKILL 之外的任何退出路径都经此归还租约;SIGKILL 由其他等待方的
# reclaim_stale_leases 兜底回收。
cleanup_lease_force() {
  if [[ -n "$HB_PID" ]]; then kill "$HB_PID" 2>/dev/null; HB_PID=""; fi
  if [[ -n "$GPU_ID" ]]; then
    redis_cmd DEL "task_heartbeat:$OWNER" >/dev/null 2>&1
    release_gpu "$GPU_ID" "$OWNER"
  fi
}

cleanup_lease() {
  local rc=$?
  if [[ -n "$HB_PID" ]]; then
    kill "$HB_PID" 2>/dev/null
  fi
  if [[ -n "$GPU_ID" ]]; then
    redis_cmd DEL "task_heartbeat:$OWNER" >/dev/null 2>&1
    release_gpu "$GPU_ID" "$OWNER"
    echo "[msa-gpu] released GPU $GPU_ID" >&2
  fi
  exit $rc
}
trap 'exit 143' TERM
trap 'exit 130' INT
trap cleanup_lease EXIT

LEASE=$(lease_gpu)
lease_rc=$?
if [[ $lease_rc -ne 0 ]]; then
  echo "[msa-gpu] lease failed (rc=$lease_rc); failing job so the ticket errors out visibly" >&2
  exit 75
fi

GPU_ID=${LEASE%% *}
OWNER=${LEASE#* }
echo "[msa-gpu] leased GPU $GPU_ID ($OWNER)" >&2
start_heartbeat

MSA_ORIG_ARGS=("$@")   # 函数内的 "$@" 是函数参数(GPU ID),必须先保存外层命令
run_gpu_search() {  # $1=gpu; 输出rc
  CUDA_VISIBLE_DEVICES="$1" timeout -k 60 "$MMSEQS_GPU_SEARCH_TIMEOUT" \
    "$real_bin" "${MSA_ORIG_ARGS[@]}" --gpu 1 --prefilter-mode 1
  local rc=$?
  if (( rc == 124 || rc == 137 )); then
    echo "[msa-gpu] search exceeded ${MMSEQS_GPU_SEARCH_TIMEOUT}s; killed (stuck-search protection)" >&2
    return 124
  fi
  return $rc
}

# CUDA 资源类崩溃自愈:还卡重租(大概率换卡)再试;超时击杀不重试。
attempt=0
while :; do
  run_gpu_search "$GPU_ID"
  run_rc=$?
  if (( run_rc != 0 && attempt < 4 && run_rc != 124 )); then
    attempt=$((attempt+1))
    echo "[msa-gpu] search rc=$run_rc on GPU $GPU_ID; releasing and retrying ($attempt/4)" >&2
    cleanup_lease_force
    LEASE=$(lease_gpu) || { echo "[msa-gpu] re-lease failed" >&2; exit 75; }
    GPU_ID=${LEASE%% *}; OWNER=${LEASE#* }
    echo "[msa-gpu] retrying on GPU $GPU_ID" >&2
    start_heartbeat
    continue
  fi
  break
done

exit $run_rc
