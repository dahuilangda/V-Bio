# 必改项 1：代码目录（宿主机绝对路径）
BOLTZ_HOST_ROOT=/data/V-Bio
RESULTS_BASE_DIR=/data/boltz_central_results

# 必改项 2：中央连接
BOLTZ_API_TOKEN=change-me
REDIS_URL=redis://<CENTRAL_HOST_OR_IP>:6379/0
CENTRAL_API_URL=http://<CENTRAL_HOST_OR_IP>:5000

# 必改项 3：CPU 能力声明（逗号分隔，如仅 lead-opt: lead_opt；承接多肽父编排: lead_opt,peptide_design）
CPU_WORKER_CAPABILITIES=lead_opt,peptide_design,export

# 并发：0=自动使用全部CPU核心
CPU_MAX_CONCURRENT_TASKS=0

# 多肽设计超时控制
# `0` 表示禁用硬超时/无限等待，适合多父任务、多子任务共享 GPU 队列
PREDICTION_SUBPROCESS_TIMEOUT_SECONDS=10800
PEPTIDE_CANDIDATE_SUBPROCESS_TIMEOUT_SECONDS=0
PEPTIDE_PARENT_SUBPROCESS_TIMEOUT_SECONDS=0
PEPTIDE_PARENT_TIMEOUT_PER_WAVE_SECONDS=1800
PEPTIDE_PARENT_TIMEOUT_BUFFER_SECONDS=1800
PEPTIDE_GPU_ACQUIRE_TIMEOUT_SECONDS=0



# Task-completion email notifications (optional per-submit notify_email)
FRONTEND_URL=http://<HOST_IP>:5173
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USER=<account@126.com>
SMTP_PASS=<authorization-code>
SMTP_SENDER_NAME=V-Bio

# Notifications / limits / images
NOTIFY_DIGEST_WINDOW_SECONDS=900
TENANT_MAX_DAILY=50
PROTENIX2DOCK_AFFINITY_CKPT=
P2D_IMAGE=vbio-protenix-v2-runtime:2.0.0
