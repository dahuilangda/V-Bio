# 必改项 1：代码目录（宿主机绝对路径）
BOLTZ_HOST_ROOT=/data/V-Bio

# 可选：端口
API_HOST_PORT=5000

# API 必须监听容器 eth0：宿主端口映射与 worker 的 CENTRAL_API_URL 依赖此地址
# （变更端口需走 docker compose up -d api 重建生效）
VBIO_RUNTIME_BIND=0.0.0.0

# 必改项 2：统一令牌（与 worker/frontend 一致）
BOLTZ_API_TOKEN=change-me

# 必改项 3：外部 Redis 地址（解耦部署）
REDIS_URL=redis://<REDIS_HOST_OR_IP>:6379/0

# 中央 API 对外地址（用于任务状态/结果回传）
CENTRAL_API_URL=http://127.0.0.1:5000

VBIO_MONITOR_DATABASE_URL=postgresql://authenticator:authenticator@host.docker.internal:54322/postgres
VBIO_MONITOR_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres


# 必改项 4：ColabFold MSA 服务（可独立部署）
MSA_SERVER_URL=http://<MSA_HOST_OR_IP>:8080
MSA_SERVER_TIMEOUT_SECONDS=1800
COLABFOLD_JOBS_DIR=/data/colabfold/jobs

# 可选：结果目录与保留期
RESULTS_BASE_DIR=/data/boltz_central_results
# 运行时临时目录由 monitor 服务定期清理（按文件 mtime 距今计算）
RESULTS_RETENTION_DAYS=90
# 结果清理开关（1/true/yes/on 开启）
RESULTS_CLEANUP_ENABLED=1
# 结果清理执行间隔（秒）：monitor 启动后先执行一轮，之后按此周期复查
RESULTS_CLEANUP_INTERVAL_SECONDS=21600
# MSA(a3m) 序列缓存保留天数（缓存可重建，默认与任务结果一致为 90 天）
MSA_CACHE_RETENTION_DAYS=90
