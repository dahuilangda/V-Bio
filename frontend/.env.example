# Leave empty to use Vite proxy for backend API (default: http://127.0.0.1:5000).
VITE_API_BASE_URL=

# frontend Management API base URL (recommended for cURL / token-scoped access), e.g. http://127.0.0.1:5055/vbio-api
VITE_VBIO_MANAGEMENT_API_BASE_URL=

# Must match backend BOLTZ_API_TOKEN.
VITE_API_TOKEN=development-api-token

# Super admin identities. Only these users can open user and integration management.
VITE_SUPER_ADMIN_USERNAMES=dahuilangda
VITE_SUPER_ADMIN_EMAILS=dahuilangda@hotmail.com

# Local Supabase-lite (PostgREST) endpoint for project persistence, e.g. http://127.0.0.1:54321
VITE_SUPABASE_REST_URL=http://127.0.0.1:54321

# PostgreSQL is the authoritative Monitor store (authenticator role; service_role per transaction).
VBIO_MONITOR_DATABASE_URL=postgresql://authenticator:authenticator@127.0.0.1:54322/postgres
VBIO_MONITOR_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
VBIO_MGMT_WORKERS=2
VBIO_MGMT_THREADS=8

# External system login settings. These are read by frontend/server/vbio_management_api.py.
VBIO_JWT_CLIENTS_FILE=frontend/.run/jwt_clients.json
VBIO_SESSION_SECRET=<server-session-secret>

# Copilot settings — read by the server process, not the browser bundle.
VBIO_COPILOT_API_URL=https://your-copilot-endpoint.example/v1/chat/completions
VBIO_COPILOT_API_KEY=<COPILOT_API_KEY>
VBIO_COPILOT_MODEL=gemma4-31b

# Operator contact email for UniProt/NCBI lookups (so they contact you instead of blocking the IP).
VBIO_COPILOT_CONTACT_EMAIL=you@example.org
# Optional NCBI-specific overrides: an E-utilities key lifts the 3 req/s limit to 10 req/s.
# VBIO_COPILOT_NCBI_EMAIL=you@example.org
# VBIO_COPILOT_NCBI_API_KEY=<NCBI_API_KEY>

# Optional: Copilot runtime settings file (defaults to frontend/.run/copilot_settings.json).
# VBIO_COPILOT_SETTINGS_FILE=frontend/.run/copilot_settings.json

# Optional: override remote script sources.
VITE_JSME_SCRIPT_URL=/vendor/jsme/jsme.nocache.js
VITE_MOLSTAR_SCRIPT_URL=/vendor/molstar/molstar.js
VITE_MOLSTAR_CSS_URL=/vendor/molstar/molstar.css
# RDKit defaults to the jsdelivr CDN; offline deployments can self-host under /vendor.
# VITE_RDKIT_SCRIPT_URL=/vendor/rdkit/rdkit.js
# VITE_RDKIT_WASM_URL=/vendor/rdkit/rdkit.wasm

# Boltz2Score MSA cache directory (worker + capability CLI both read this; default /data/boltz_msa_cache).
# BOLTZ_MSA_CACHE_DIR=/data/boltz_msa_cache

# Task-completion notification emails + password-reset links (read by the server process, not the browser)
FRONTEND_URL=http://<HOST_IP>:5173
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USER=<account@126.com>
SMTP_PASS=<authorization-code>
SMTP_SENDER_NAME=V-Bio
